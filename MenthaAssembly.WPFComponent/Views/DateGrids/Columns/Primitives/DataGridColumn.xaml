<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MenthaAssembly.Views">

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:DataGridColumn}, ResourceId=DefaultStyle}"
           TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <ControlTemplate.Resources>
                        <Style x:Key="TransparentHeaderGripperStyle"
                               TargetType="{x:Type Thumb}">
                            <Setter Property="Width" Value="6" />
                            <Setter Property="Margin" Value="-3,0" />
                            <Setter Property="Cursor" Value="SizeWE" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border Background="{TemplateBinding Background}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="HeaderFilterButtonStyle"
                               TargetType="{x:Type ToggleButton}">
                            <Setter Property="Width" Value="22" />
                            <Setter Property="Height" Value="22" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent"
                                                BorderThickness="0"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ControlTemplate.Resources>
                    <Border x:Name="HeaderBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <Grid Width="8" Height="8"
                                      Margin="4,0,0,0"
                                      VerticalAlignment="Center">
                                    <Path x:Name="SortIcon"
                                          Data="M 0 5 L 4 1 L 8 5 Z"
                                          Width="8" Height="6"
                                          Stretch="Uniform"
                                          Fill="{TemplateBinding Foreground}"
                                          Visibility="Collapsed" />
                                </Grid>
                            </StackPanel>
                            <ToggleButton x:Name="FilterButton"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Style="{StaticResource HeaderFilterButtonStyle}"
                                          Grid.Column="1">
                                <Path x:Name="FilterIcon"
                                          Data="M 1 2 L 11 2 L 7 6 L 7 10 L 5 10 L 5 6 Z"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Fill="{TemplateBinding Foreground}" />
                            </ToggleButton>
                            <Popup x:Name="FilterPopup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsChecked, ElementName=FilterButton, Mode=TwoWay}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=FilterButton}"
                                   PopupAnimation="Fade"
                                   StaysOpen="True">
                                <local:DataGridColumnFilterView Column="{Binding Column, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Popup>
                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource TransparentHeaderGripperStyle}" />
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource TransparentHeaderGripperStyle}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Column.SortDirection, RelativeSource={RelativeSource Self}}" Value="Ascending">
                            <Setter TargetName="SortIcon" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Column.SortDirection, RelativeSource={RelativeSource Self}}" Value="Descending">
                            <Setter TargetName="SortIcon" Property="Data" Value="M 0 1 L 4 5 L 8 1 Z" />
                            <Setter TargetName="SortIcon" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger SourceName="FilterButton" Property="IsMouseOver" Value="True">
                            <Setter TargetName="FilterIcon" Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                        </Trigger>
                        <Trigger SourceName="FilterButton" Property="IsPressed" Value="True">
                            <Setter TargetName="FilterIcon" Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                        </Trigger>
                        <Trigger SourceName="FilterButton" Property="IsChecked" Value="True">
                            <Setter TargetName="FilterIcon" Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Column.CanUserFilter, RelativeSource={RelativeSource Self}}" Value="False">
                            <Setter TargetName="FilterButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Column, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter TargetName="FilterButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="Name" Value="PART_FillerColumnHeader">
                            <Setter TargetName="FilterButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="0">
                            <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="1,0,1,1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Column.IsFilterActive, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="FilterIcon" Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
