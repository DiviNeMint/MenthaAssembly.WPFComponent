<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MenthaAssembly.Views">

    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:DataGridColumnFilterView}, ResourceId=DefaultStyle}"
           TargetType="{x:Type local:DataGridColumnFilterView}">
        <Setter Property="Width" Value="280" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DataGridColumnFilterView}">
                    <Border Padding="10"
                            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Sort"
                                       Margin="0,0,0,6"
                                       FontWeight="SemiBold" />
                            <Button Content="Sort Ascending"
                                    Padding="8,6"
                                    HorizontalContentAlignment="Left"
                                    Command="{x:Static local:DataGridColumnFilterView.SortAscendingCommand}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                            <Button Content="Sort Descending"
                                    Margin="0,4,0,0"
                                    Padding="8,6"
                                    HorizontalContentAlignment="Left"
                                    Command="{x:Static local:DataGridColumnFilterView.SortDescendingCommand}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                            <Button Content="Clear Sort"
                                    Margin="0,4,0,8"
                                    Padding="8,6"
                                    HorizontalContentAlignment="Left"
                                    Command="{x:Static local:DataGridColumnFilterView.ClearSortCommand}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                            <Separator Margin="0,10" />
                            <TextBlock Text="Filter"
                                       Margin="0,0,0,6"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding PendingContainsText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"
                                     ToolTip="Contains" />
                            <DockPanel Margin="0,0,0,6">
                                <Button Content="Select All"
                                        Padding="8,6"
                                        HorizontalContentAlignment="Left"
                                        Command="{x:Static local:DataGridColumnFilterView.SelectAllCommand}"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                        DockPanel.Dock="Left" />
                                <Button Content="Clear"
                                        Padding="8,6"
                                        HorizontalContentAlignment="Left"
                                        Command="{x:Static local:DataGridColumnFilterView.ClearCommand}"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                        DockPanel.Dock="Right" />
                            </DockPanel>
                            <Border MinHeight="120"
                                    MaxHeight="180"
                                    Padding="6"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                    BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Values}"
                                                  IsEnabled="{Binding IsEnabled, ElementName=ApplyButton}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Text}"
                                                          Margin="0,2"
                                                          IsChecked="{Binding IsChecked}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <Button x:Name="ApplyButton"
                                    Content="Apply"
                                    Margin="0,8,0,0"
                                    Padding="8,6"
                                    HorizontalContentAlignment="Left"
                                    Command="{x:Static local:DataGridColumnFilterView.ApplyCommand}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
